# Garage (S3 compatible, https://garagehq.deuxfleurs.fr) de un solo nodo para desarrollo: simula el S3 de produccion.
# La imagen oficial no trae shell, y hace falta uno para configurar el nodo al arrancar (docker/garage/entrypoint.sh).
FROM dxflrs/garage:v1.1.0 AS garage

FROM alpine:3.20
COPY --from=garage /garage /usr/local/bin/garage
COPY docker/garage/entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod 755 /entrypoint.sh && mkdir -p /var/lib/garage/meta /var/lib/garage/data
EXPOSE 3900
ENTRYPOINT ["/entrypoint.sh"]
