# FrankenPHP (Caddy con PHP embebido), solo HTTP: el TLS lo pone `nodo tunnel`. Escucha en :8000 (service.json -> api).
# Modo clasico (sin worker): 1 nucleo y 2 GiB compartidos con el agente, asi que pocos hilos de PHP.
{
	admin off
	auto_https off
	frankenphp {
		num_threads 2
		max_threads 6
	}
}

:8000 {
	root * /opt/nutrition/admin/public
	encode zstd gzip
	request_body {
		max_size 20MB
	}
	# Pagina de estado del arranque (estado/servidor.py la sirve mientras la web no existe; aqui, las mismas rutas con los mismos ficheros).
	handle /estado {
		root * /opt/nutrition/estado
		rewrite * /index.html
		header Cache-Control no-store
		file_server
	}
	handle /estado.json {
		root * /var/lib/nutrition/publico
		header Cache-Control no-store
		file_server
	}
	handle /app.log {
		root * /var/lib/nutrition/publico
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control no-store
		file_server
	}
	# La API interna del chat NO se sirve por el puerto publico (ni por /interno/chat, ni por /index.php/interno/chat, ni con otra
	# mayuscula): solo el sitio de 127.0.0.1:8001. Laravel exige ademas el Bearer CHAT_SECRETO y que la ruta empiece por /interno/chat.
	@interno_chat path_regexp interno_chat (?i)interno/chat
	handle @interno_chat {
		respond "no encontrado" 404
	}
	handle {
		php_server
	}
}

# API interna del chat (docs/chat-api-interna.md), solo para el traductor gRPC del mismo VM: unicamente /interno/chat/* y solo en el
# loopback. No esta en service.json -> api, asi que `nodo tunnel` no puede llegar a ella. Mismo limite de cuerpo que el contrato
# (archivos de 4 MiB en base64 caben en 8 MiB). Laravel exige ademas el Bearer CHAT_SECRETO.
http://127.0.0.1:8001 {
	bind 127.0.0.1
	root * /opt/nutrition/admin/public
	request_body {
		max_size 8MiB
	}
	handle /interno/chat/* {
		php_server
	}
	handle {
		respond "no encontrado" 404
	}
}
