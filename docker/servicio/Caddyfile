# FrankenPHP (Caddy con PHP embebido), solo HTTP: el TLS lo pone `nodo tunnel`. Escucha en :8000 (service.json -> api).
# Modo clasico (sin worker): 1 nucleo y 2 GiB compartidos con el agente, asi que pocos hilos de PHP.
{
	admin off
	auto_https off
	frankenphp {
		num_threads 2
		max_threads 6
	}
}

:8000 {
	root * /opt/nutrition/admin/public
	encode zstd gzip
	request_body {
		max_size 20MB
	}
	# Pagina de estado del arranque (estado/servidor.py la sirve mientras la web no existe; aqui, las mismas rutas con los mismos ficheros).
	handle /estado {
		root * /opt/nutrition/estado
		rewrite * /index.html
		header Cache-Control no-store
		file_server
	}
	handle /estado.json {
		root * /var/lib/nutrition/publico
		header Cache-Control no-store
		file_server
	}
	handle /app.log {
		root * /var/lib/nutrition/publico
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control no-store
		file_server
	}
	handle {
		php_server
	}
}
