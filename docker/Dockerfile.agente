# Contenedor del agente (fase A): solo Claude Code, Python (biblioteca estandar) y un pequeno servidor interno
# (runner.py) por el que la administracion le pide ejecuciones. No lleva PHP ni ve la base de datos, el .env ni las
# claves de la administracion. El kit (agente/: skills, scripts, CLAUDE.md...) va dentro de la imagen y se copia a su volumen
# propio al arrancar; lo que comparte con la administracion (encargos/, workspace/, base/) viaja por el bucket S3 (Garage en desarrollo).
FROM node:22-bookworm-slim

ARG UID=1000
ARG GID=1000

RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates sqlite3 \
        python3 python-is-python3 \
    && rm -rf /var/lib/apt/lists/*

# consumos.py y el runner solo usan la biblioteca estandar de Python: no hay librerias pip.
RUN npm install -g @anthropic-ai/claude-code

# El servidor va en la imagen, propiedad de root: el agente (que puede escribir en agente/) no puede reescribirlo.
# El kit, sin base/ workspace/ encargos/ (ver .dockerignore): se copia a /app/agente en cada arranque (docker/agente/entrypoint.sh).
COPY agente /opt/agente-kit
# Marca de «kit instalado» (la que deja /setup): en el contenedor no hay nadie que ejecute /setup y sin ella el agente se niega a
# trabajar en modo encargo. Se escribe a mano (doctor.py --marcar crearia base/ y workspace/ dentro del kit).
RUN mkdir -p /opt/agente-kit/.claude \
    && echo '{"fecha": "imagen-docker", "sistema": "Linux (contenedor del agente)", "python": "python", "persona": "Personal Nutrition"}' \
        > /opt/agente-kit/.claude/setup-completado.json
COPY docker/agente/runner.py /opt/runner/runner.py
COPY docker/agente/almacen_s3.py /opt/runner/almacen_s3.py
COPY docker/agente/entrypoint.sh /opt/runner/entrypoint.sh
RUN sed -i 's/\r$//' /opt/runner/entrypoint.sh /opt/runner/runner.py /opt/runner/almacen_s3.py && chmod 755 /opt/runner/entrypoint.sh \
    && (getent passwd ${UID} | cut -d: -f1 | xargs -r userdel -r || true) \
    && (getent group ${GID} | cut -d: -f1 | xargs -r groupdel || true) \
    && groupadd -g ${GID} app && useradd -m -u ${UID} -g ${GID} -s /bin/bash app \
    && mkdir -p /app/agente /var/lib/agente-estado && chown -R app:app /app /var/lib/agente-estado

USER app
WORKDIR /app/agente
ENV AGENTE_CARPETA=/app/agente
# Ejecuciones del runner: en un volumen para que un reinicio no las pierda (ver runner.py).
ENV AGENTE_ESTADO=/var/lib/agente-estado
EXPOSE 9000
ENTRYPOINT ["/opt/runner/entrypoint.sh"]
