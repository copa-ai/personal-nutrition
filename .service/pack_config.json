{
    "service_dependencies_directory": "__services__",
    "metadata_dependencies_directory": "__metadata__",
    "blocks_directory": "__block__",
    "dependencies": {
        "NUTRITION_POSTGRES": "dependencies/postgres"
    },
    "dependencies_env": true,
    "include": [
        "admin",
        "agente",
        "docker/agente",
        "docker/chat",
        "docker/servicio",
        ".service/pack_config.json"
    ],
    "ignore": [
        "vendor/",
        "node_modules/",
        "tests/",
        "__pycache__/",
        "*.pyc",
        "*.sqlite*",
        "*.enc",
        ".env",
        ".env.*",
        "storage/logs/*",
        "storage/framework/*",
        "agente/base/",
        "agente/workspace/",
        "agente/encargos/",
        ".cc-writes/",
        ".git/"
    ]
}
