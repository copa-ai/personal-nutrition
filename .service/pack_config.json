{
    "service_dependencies_directory": "__services__",
    "metadata_dependencies_directory": "__metadata__",
    "blocks_directory": "__block__",
    "dependencies": {
        "NUTRITION_POSTGRES": "dependencies/postgres"
    },
    "dependencies_env": true,
    "include": [
        "admin",
        "agente",
        "dependencies",
        "docker",
        "docs",
        "README.md",
        ".service"
    ],
    "ignore": [
        "vendor/",
        "node_modules/",
        "__pycache__/",
        "*.pyc",
        "*.sqlite*",
        "*.enc",
        ".env",
        ".env.*",
        "storage/logs/*",
        "storage/framework/*",
        "bootstrap/cache/*.php",
        "generado/",
        "agente/base/",
        "agente/workspace/",
        "agente/encargos/",
        ".cc-writes/",
        ".git/"
    ]
}
