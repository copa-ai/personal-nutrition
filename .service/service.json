{
    "tag": "personal-nutrition",
    "architecture": "linux/arm64",
    "resources": {
        "at_init": {
            "mem_limit": 2147483648,
            "disk_space": 4294967296,
            "cpu_period": 100000,
            "cpu_quota": 100000
        },
        "at_most": {
            "mem_limit": 2147483648,
            "disk_space": 4294967296,
            "cpu_period": 100000,
            "cpu_quota": 100000
        }
    },
    "init": {
        "entry_path": ["opt", "nutrition", "start.sh"]
    },
    "api": [
        {
            "port": 8000,
            "transport": "tcp",
            "protocol": ["http1.1", "http"]
        }
    ],
    "envs": ["APP_URL", "APP_TIMEZONE", "AGENTE_MODELO", "AGENTE_MAX_SIMULTANEAS", "APP_KEY", "NUTRITION_DB_CLUSTER", "NUTRITION_DB_PASSWORD"],
    "network": [
        {
            "tags": ["*"],
            "prose": "Salida a internet abierta: el agente (Claude Code) llama a la API de Anthropic por nombre de host y el guest no resuelve nombres desde __config__"
        },
        {
            "tags": ["postgres:personal-nutrition"],
            "prose": "PostgreSQL database holding the personal-nutrition schema (the Laravel migrations of personal-nutrition). Every personal-nutrition instance that uses the same cluster key shares this database.",
            "formal": {
                "db.engine": "postgresql",
                "db.schema": "personal-nutrition",
                "db.cluster": "${NUTRITION_DB_CLUSTER}"
            },
            "protocol_stack": [
                {
                    "tags": ["postgresql"]
                }
            ]
        }
    ],
    "possible_environment_workload": [
        {
            "workloads": [
                {
                    "count": 1,
                    "resources": {
                        "mem_limit": 1073741824,
                        "disk_space": 10737418240
                    }
                }
            ]
        }
    ]
}
